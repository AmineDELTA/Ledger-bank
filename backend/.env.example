# Server Port (Render sets this dynamically via PORT)
PORT=8080

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/core_banking
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=admin123

# Database Connection Pool (HikariCP)
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5

# Redis Configuration (used for idempotency lock & receipt caching)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# CORS Allowed Origin Patterns (comma-separated or * for all)
CORS_ALLOWED_ORIGIN_PATTERNS=*

# Logging
LOG_FILE=logs/audit.log
SPRING_JPA_SHOW_SQL=false
